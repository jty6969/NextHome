# Copy to .env.local in the repository root (already ignored by Git).
# Existing local map-config.json baiduAk is reused automatically.
# Optional explicit provider: baidu or amap. Empty selects a configured provider.
MAP_PROVIDER=
# Optional override for the saved Baidu browser JS API key.
BAIDU_PUBLIC_JS_KEY=
# To use AMap instead, supply a matching Web/JS key and server-only security code.
AMAP_PUBLIC_JS_KEY=
AMAP_SECURITY_JS_CODE=
# Optional. Set only when it is known for the imported data.
MAP_COORDINATE_SYSTEM=
MAP_GEOCODE_CITY=
